{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "projectSettings": {
    "framework": "services"
  },
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "danforun-replica": {
      "root": "artifacts/danforun-replica",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "api-server",
          "format": "url",
          "env": "API_SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "danforun-replica" }
    }
  ]
}